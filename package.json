{
  "name": "maxery-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "MAXERY - Secure Emergency Identification and Trusted-Contact Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@maxery/api",
    "dev:web": "npm run dev --workspace=@maxery/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@maxery/web --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:push": "prisma db push",
    "check:env": "node scripts/check-environment.js",
    "setup": "node scripts/setup.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.14.0",
    "prettier": "^3.5.1",
    "prisma": "^6.4.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
