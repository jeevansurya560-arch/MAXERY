# =====================================================================
# MAXERY Monorepo Environment Template
# NEVER COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS
# =====================================================================

NODE_ENV=development

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://maxery_user:maxery_secure_pass@localhost:5432/maxery_dev?schema=public

# Fastify Backend Service Configuration
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET=maxery_dev_jwt_secret_key_minimum_32_characters_for_security_checks
CORS_ORIGIN=http://localhost:3000

# Optional Redis Cache / PubSub (Leave empty or commented if not running Redis)
REDIS_URL=redis://localhost:6379

# Next.js Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
