# =====================================================================
# MAXERY Monorepo Environment Template
# NEVER COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS
# =====================================================================

NODE_ENV=development

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://maxery_user:maxery_secure_pass@localhost:5432/maxery_dev?schema=public

# Fastify Backend Service Configuration
API_PORT=4000
API_HOST=0.0.0.0

# Session secret (minimum 32 characters, random in production)
# MUST be changed to a strong random value in production.
SESSION_SECRET=maxery_dev_session_secret_change_in_production_minimum_32_chars

# Session timeouts (seconds)
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200

CORS_ORIGIN=http://localhost:3000

# Optional Redis Cache / PubSub (Leave empty or commented if not running Redis)
REDIS_URL=redis://localhost:6379

# Next.js Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
