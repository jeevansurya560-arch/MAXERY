# =====================================================================
# MAXERY Monorepo Environment Template
# NEVER COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS
# =====================================================================

NODE_ENV=development

# Database Configuration (Neon PostgreSQL / Local PostgreSQL 16)
# For Neon, use the pooled connection string (-pooler) for application queries:
DATABASE_URL=postgresql://maxery_user:maxery_secure_pass@localhost:5432/maxery_dev?schema=public&connect_timeout=15
# Direct unpooled connection URL (required for Prisma migrations on Neon):
DIRECT_URL=postgresql://maxery_user:maxery_secure_pass@localhost:5432/maxery_dev?schema=public

# Fastify Backend Service Configuration
API_PORT=4000
API_HOST=0.0.0.0

# Better Auth & Google OAuth 2.0 Configuration
BETTER_AUTH_SECRET=maxery_dev_session_secret_change_in_production_minimum_32_chars
BETTER_AUTH_URL=http://localhost:4000
# Obtain from Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Web Client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session secret (minimum 32 characters, random in production)
# MUST be changed to a strong random value in production.
SESSION_SECRET=maxery_dev_session_secret_change_in_production_minimum_32_chars

# Session timeouts (seconds)
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200

CORS_ORIGIN=http://localhost:3000

# Optional Redis Cache / PubSub (Leave empty or commented if not running Redis)
REDIS_URL=redis://localhost:6379

# Next.js Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
